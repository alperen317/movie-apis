{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "movie-api",
    "Audience": "movie-app",

    // Shorter than Supabase's hour. An access token cannot be revoked, so
    // signing out stops renewal but leaves the token itself usable — including
    // for writes — until it expires. This is the length of that window.
    "AccessTokenMinutes": 15
  },

  // Empty by default -- the Sentry SDK is a no-op with no Dsn configured, the
  // same behavior as the mobile client's EXPO_PUBLIC_SENTRY_DSN. Set via the
  // Sentry__Dsn environment variable when a project exists to send to.
  "Sentry": {
    "Dsn": ""
  }
}
