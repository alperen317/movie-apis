# Copy to .env on the VPS and fill in real values. Used by
# `docker compose -f docker-compose.prod.yml`; docker-compose.yml (dev)
# does not read this file, it hardcodes its own dev-only values.

POSTGRES_PASSWORD=

# Real production domain, e.g. api.example.com. Left empty, AllowedHosts
# falls back to "*" (Host header validation off) -- see docker-compose.prod.yml.
ALLOWED_HOSTS=

# At least 32 bytes (see JwtOptions.MinimumSigningKeyBytes) -- generate with
# `openssl rand -base64 48`, not a memorable phrase.
JWT_SIGNING_KEY=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Optional -- leave empty and Sentry stays a no-op, see appsettings.json.
SENTRY_DSN=
